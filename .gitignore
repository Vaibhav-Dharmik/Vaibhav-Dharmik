# Portfolio / profile repo ignore rules

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build outputs
.next/
out/

# Production builds
/build
/dist

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Environment variables
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
/coverage/
.nyc_output

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript
*.tsbuildinfo

# Temporary folders
tmp/
temp/
